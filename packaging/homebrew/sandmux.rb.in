# Fórmula do sandmux (só Linux). Copie para um tap: brew install <tap>/sandmux
class Sandmux < Formula
  desc "Multiplexador de terminal para agentes de código em sandbox"
  homepage "https://github.com/alanyoshida/sandmux"
  url "https://github.com/alanyoshida/sandmux/releases/download/v@VERSION@/sandmux-@VERSION@-x86_64-linux.tar.gz"
  sha256 "@SHA256@"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  depends_on :linux
  depends_on arch: :x86_64

  def install
    %w[sandmux sandmuxd sandmux-run sandmux-chat sandmux-db-mcp].each { |b| bin.install "bin/#{b}" }
    pkgshare.install "apparmor"
  end

  def caveats
    <<~EOS
      Rode `sandmux setup` para conferir o suporte, subir o daemon e, nas
      distros que restringem user namespaces (Ubuntu), instalar o perfil do
      AppArmor do lançador com sudo.
    EOS
  end

  test do
    assert_match "sandmux", shell_output("#{bin}/sandmux --version")
  end
end
