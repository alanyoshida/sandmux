# Maintainer: Alan Yoshida <alanyoshida at users dot noreply dot github dot com>
pkgname=sandmux-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Multiplexador de terminal para agentes de código em sandbox"
arch=('x86_64')
url="https://github.com/alanyoshida/sandmux"
license=('MIT' 'Apache-2.0')
provides=('sandmux')
conflicts=('sandmux')
source=("https://github.com/alanyoshida/sandmux/releases/download/v${pkgver}/sandmux-${pkgver}-x86_64-linux.tar.gz")
sha256sums=('@SHA256@')
install=sandmux.install

package() {
    cd "sandmux-${pkgver}-x86_64-linux"
    for b in sandmux sandmuxd sandmux-run sandmux-chat sandmux-db-mcp; do
        install -Dm0755 "bin/$b" "$pkgdir/usr/bin/$b"
    done
    install -Dm0644 /dev/stdin "$pkgdir/etc/apparmor.d/sandmux-run" \
        < <(sed 's|@SANDMUX_RUN@|/usr/bin/sandmux-run|' apparmor/sandmux-run)
    install -Dm0644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm0644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
