#!/bin/sh
# Carrega o perfil do AppArmor do lançador, quando o AppArmor está presente.
set -e
if [ "$1" = configure ] && command -v apparmor_parser >/dev/null 2>&1 \
    && [ -d /sys/kernel/security/apparmor ]; then
    apparmor_parser -r /etc/apparmor.d/sandmux-run || true
fi
echo "sandmux: rode \`sandmux setup\` como o seu usuário para subir o daemon e conferir o suporte." >&2
exit 0
